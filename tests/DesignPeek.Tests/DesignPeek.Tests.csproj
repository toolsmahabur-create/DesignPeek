<Project Sdk="Microsoft.NET.Sdk">

  <!-- Dependency-free test runner: builds synthetic PSD/PSB samples, checks the parser, and leaves
       the samples on disk so CI can run them through the real native shim as well. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>DesignPeek.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\DesignPeek.Core\DesignPeek.Core.csproj" />
  </ItemGroup>

</Project>
