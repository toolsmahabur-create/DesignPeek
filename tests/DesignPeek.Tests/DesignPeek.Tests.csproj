<Project Sdk="Microsoft.NET.Sdk">

  <!-- CI-only test runner (not shipped): builds synthetic PSD/PSB samples and checks the native
       worker and app against them. WPF is used only to encode the sample JPEG thumbnails. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>DesignPeek.Tests</RootNamespace>
  </PropertyGroup>

</Project>
