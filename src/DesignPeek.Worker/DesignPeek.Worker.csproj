<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The worker is the only place where untrusted design files are parsed.
    It is started by the native shim (DesignPeek.Shim.dll) for every request, runs inside a
    Windows Job Object (300 MB memory cap) and is killed if it exceeds the timeout.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>DesignPeek.Worker</RootNamespace>
    <AssemblyName>DesignPeek.Worker</AssemblyName>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishReadyToRun>true</PublishReadyToRun>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <!-- Keep the managed heap well below the 300 MB job limit. -->
    <RuntimeHostConfigurationOption Include="System.GC.HeapHardLimit" Value="209715200" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DesignPeek.Core\DesignPeek.Core.csproj" />
  </ItemGroup>

</Project>
